# Required: reset this immediately if it is ever exposed.
DISCORD_TOKEN=replace_with_your_bot_token

# Optional settings
DM_ROLE_NAME=DM
DATABASE_PATH=rpg_bot.db
CHARACTER_MEDIA_PATH=data/characters
DICE_THEME=classic

# Recommended during development for near-instant command registration.
# Enable Developer Mode in Discord, right-click your server, and copy its ID.
DISCORD_GUILD_ID=
